# Frontend Environment Variables
# This file is for frontend-specific configuration (Vite)

# Backend API Configuration (OAuth2 token exchange and refresh)
VITE_API_BASE_URL=http://localhost:3000

# WebRTC signaling server — the frontend connects directly via WebSocket
VITE_VIDEO_SIGNALING_URL=wss://signaling.webrtc.connect.axis.com/v1/client

# ACC API Configuration — frontend calls the ACC REST API directly
VITE_ACC_BASE_URL=https://api.connect.axis.com/v1

# EdgeLink Configuration — frontend calls EdgeLink directly
VITE_EDGELINK_BASE_URL=https://edgelink.connect.axis.com/v1

# Axis Device Assistant (ADA) — used for opening the device management interface
VITE_ADA_BASE_URL=https://device.axis.com
