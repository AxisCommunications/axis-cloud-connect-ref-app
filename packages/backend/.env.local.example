NODE_ENV=development

# Server Configuration
PORT=3000

# OAuth2 Configuration
OAUTH2_AUTHORIZATION_URL=https://oauth.eu.prod.k8s.connect.axis.com/oauth2/auth
# Required. Register an OAuth 2.0 client at https://portal.connect.developer.axis.com/ to get these values.
OAUTH2_CLIENT_ID=
# Keep the client secret quoted "123ABCexampleSecret"; generated secrets may contain characters that require quoting.
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3000/callback
OAUTH2_SCOPES="openid offline video_service"
OAUTH2_TOKEN_URL=https://oauth.eu.prod.k8s.connect.axis.com/oauth2/token

# CORS Configuration — Allow frontend origin
CORS_ORIGIN=http://localhost:5173
